generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchlist     Watchlist[]
  trades        UserTrade[]
  settings      UserSettings?
  signalActivations UserSignalActivation[]
  actions       UserAction[]
  preferences   UserPreferences?
  watchlistFolders WatchlistFolder[]
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])
  riskTolerance         String   @default("moderate") // conservative, moderate, aggressive
  maxPositionSize       Float    @default(1000)
  preferredExpiry       String   @default("weekly") // 0dte, weekly, monthly
  notificationsEnabled  Boolean  @default(true)
  darkMode              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Signal {
  id              String   @id @default(cuid())
  ticker          String
  signalType      String   // 0DTE, WEEKLY, EARNINGS, DARK_POOL, NEWS
  direction       String   // CALL, PUT
  strikePrice     Float
  expirationDate  DateTime
  entryPrice      Float
  stopLoss        Float
  targetPrice     Float
  confidence      Float    // 0-100 percentage

  // Signal factors
  flowScore       Float    // Institutional flow score
  volumeScore     Float    // Volume analysis score
  oiScore         Float    // Open interest score
  technicalScore  Float    // Technical analysis score
  sentimentScore  Float    // News/sentiment score
  volatilityScore Float    // VIX/IV analysis

  // Risk metrics
  riskLevel       String   // LOW, MEDIUM, HIGH, EXTREME
  maxLoss         Float
  potentialGain   Float
  riskReward      Float

  // Metadata
  reasoning       String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime
  isActive        Boolean  @default(true)

  // Relations
  watchlistItems  Watchlist[]
  trades          UserTrade[]
  accuracy        SignalAccuracy?
  activations     UserSignalActivation[]
}

model SignalAccuracy {
  id              String   @id @default(cuid())
  signalId        String   @unique
  signal          Signal   @relation(fields: [signalId], references: [id])

  outcome         String   // WIN, LOSS, BREAKEVEN, PENDING
  actualReturn    Float?
  hitTarget       Boolean?
  hitStopLoss     Boolean?
  maxDrawdown     Float?
  peakGain        Float?

  closedAt        DateTime?
  closingPrice    Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id])
  folderId  String?
  folder    WatchlistFolder? @relation(fields: [folderId], references: [id])
  notes     String?
  alertSet  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, signalId])
  @@index([userId, folderId])
}

model WatchlistFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?  // Optional color coding (hex value)
  order     Int      @default(0) // Display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Watchlist[]

  @@index([userId])
  @@index([userId, order])
}

model UserSignalActivation {
  id            String   @id @default(cuid())
  userId        String
  signalId      String
  activated     Boolean  @default(false)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([userId])
  @@index([signalId])
  @@index([activated])
}

model UserTrade {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  signalId        String?
  signal          Signal?  @relation(fields: [signalId], references: [id])

  ticker          String
  direction       String
  strikePrice     Float
  expirationDate  DateTime
  entryPrice      Float
  exitPrice       Float?
  quantity        Int

  status          String   @default("OPEN") // OPEN, CLOSED
  outcome         String?  // WIN, LOSS, BREAKEVEN
  pnl             Float?
  pnlPercentage   Float?

  enteredAt       DateTime @default(now())
  exitedAt        DateTime?
  notes           String?
}

model MarketData {
  id            String   @id @default(cuid())
  ticker        String
  timestamp     DateTime

  // Price data
  open          Float
  high          Float
  low           Float
  close         Float
  volume        BigInt

  // Options specific
  impliedVolatility Float?
  historicalVolatility Float?

  // Indicators
  vwap          Float?
  rsi           Float?
  macd          Float?

  createdAt     DateTime @default(now())

  @@unique([ticker, timestamp])
  @@index([ticker])
  @@index([timestamp])
}

model OptionsFlow {
  id              String   @id @default(cuid())
  ticker          String
  timestamp       DateTime

  strikePrice     Float
  expirationDate  DateTime
  optionType      String   // CALL, PUT

  volume          Int
  openInterest    Int
  premium         Float

  // Flow analysis
  isUnusual       Boolean  @default(false)
  isSweep         Boolean  @default(false)
  isBlock         Boolean  @default(false)
  sentiment       String   // BULLISH, BEARISH, NEUTRAL

  createdAt       DateTime @default(now())

  @@index([ticker])
  @@index([timestamp])
}

model NewsArticle {
  id            String   @id @default(cuid())
  ticker        String?
  title         String
  summary       String   @db.Text
  source        String
  url           String
  publishedAt   DateTime

  sentiment     String   // POSITIVE, NEGATIVE, NEUTRAL
  sentimentScore Float   // -1 to 1
  relevance     Float    // 0 to 1

  createdAt     DateTime @default(now())

  @@index([ticker])
  @@index([publishedAt])
}

model SystemMetrics {
  id              String   @id @default(cuid())
  date            DateTime @unique

  // Overall performance
  totalSignals    Int
  winningSignals  Int
  losingSignals   Int
  winRate         Float
  avgReturn       Float

  // By signal type
  zeroDteWinRate  Float?
  weeklyWinRate   Float?
  earningsWinRate Float?
  darkPoolWinRate Float?
  newsWinRate     Float?

  // Risk metrics
  avgRiskReward   Float
  maxDrawdown     Float
  sharpeRatio     Float?

  createdAt       DateTime @default(now())
}

model UserAction {
  id         String   @id @default(cuid())
  userId     String
  action     String   // "signal_activated", "signal_viewed", "trade_entered", etc.
  entityId   String?  // ID of signal/trade/etc
  metadata   Json?    // Additional context
  deviceType String   // "web", "ios", "android", "extension"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([deviceType])
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  defaultFilters        Json?    // Saved filter preferences
  notificationSettings  Json?    // Notification preferences
  watchlistView         String?  // "list", "grid", "compact"
  theme                 String?  // "light", "dark", "auto"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BacktestRun {
  id              String   @id @default(cuid())
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  initialCapital  Float    @default(10000)
  positionSize    Float    @default(1000)

  // Filters
  signalTypes     Json?    // Array of signal types to include
  minConfidence   Float?   // Minimum confidence threshold
  maxRisk         String?  // Maximum risk level

  // Results
  totalTrades     Int      @default(0)
  winningTrades   Int      @default(0)
  losingTrades    Int      @default(0)
  winRate         Float?
  totalReturn     Float?
  totalPnL        Float?
  avgReturn       Float?
  maxDrawdown     Float?
  sharpeRatio     Float?

  status          String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  errorMessage    String?

  createdAt       DateTime @default(now())
  completedAt     DateTime?

  trades          BacktestTrade[]

  @@index([status])
  @@index([createdAt])
}

model BacktestTrade {
  id              String   @id @default(cuid())
  backtestRunId   String
  signalId        String?  // Reference to original signal if exists

  ticker          String
  signalType      String
  direction       String
  strikePrice     Float
  expirationDate  DateTime

  entryPrice      Float
  exitPrice       Float
  entryDate       DateTime
  exitDate        DateTime

  quantity        Int      @default(1)
  pnl             Float
  returnPercent   Float
  outcome         String   // WIN, LOSS, BREAK_EVEN

  confidence      Float
  riskLevel       String

  backtestRun     BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@index([backtestRunId])
  @@index([outcome])
  @@index([ticker])
}

model HistoricalSignalOutcome {
  id              String   @id @default(cuid())
  signalId        String   @unique

  ticker          String
  signalType      String
  direction       String
  strikePrice     Float
  expirationDate  DateTime

  entryPrice      Float
  entryDate       DateTime

  exitPrice       Float?
  exitDate        DateTime?

  highPrice       Float?   // Highest price reached
  lowPrice        Float?   // Lowest price reached

  outcome         String?  // WIN, LOSS, BREAK_EVEN, EXPIRED
  actualReturn    Float?

  maxDrawdown     Float?   // Max drawdown from entry
  maxProfit       Float?   // Max profit from entry

  dataCollectedAt DateTime @default(now())

  @@index([ticker])
  @@index([outcome])
  @@index([expirationDate])
}
